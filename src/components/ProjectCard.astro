---
const { project } = Astro.props;
---
<li class="project-row">
  <span class="project-number">{project.number}</span>
  <div class="project-copy">
    <h3>{project.href ? <a href={project.href}>{project.title}<span aria-hidden="true"> ↗</span></a> : project.title}</h3>
    <p>{project.description}</p>
  </div>
  <div class="project-meta"><span>{project.category}</span><span>{project.year}</span><small>{project.status}</small></div>
</li>
