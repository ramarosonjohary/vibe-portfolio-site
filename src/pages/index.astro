---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { projects } from '../data/projects.js';
---
<BaseLayout title="Johary Ramaroson — Personal Website" description="Johary Ramaroson studies Business and Computer Science at Brandeis University. Explore his work in product design, student leadership, and community access.">
  <section class="hero wrap" aria-labelledby="home-heading">
    <p class="eyebrow"><span class="accent" aria-hidden="true">●</span> A personal website / Johary Ramaroson</p>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="home-heading">Business, code<br />&amp; <em>community</em><span class="accent">.</span></h1>
        <div class="hero-bottom"><p>I’m Johary, a Business and Computer Science student at Brandeis University. My experience spans product design, student leadership, and helping students access English testing.</p><div class="hero-links"><a class="text-link" href="/projects">Explore my projects <span aria-hidden="true">↗</span></a><a class="quiet-link" href="/about">A little about me <span aria-hidden="true">→</span></a></div></div>
      </div>
      <img class="homepage-portrait" src="/JoharyPic.jpeg" alt="Johary Ramaroson, smiling in a white shirt" width="1664" height="2560" loading="eager" decoding="async" />
    </div>
  </section>
  <section class="section wrap" aria-labelledby="selected-heading">
    <div class="section-heading"><div><p class="eyebrow">01 / Work &amp; leadership</p><h2 id="selected-heading">Selected experiences</h2></div><a class="text-link" href="/projects">All experiences <span aria-hidden="true">↗</span></a></div>
    <ol class="project-list">{projects.slice(0, 3).map(project => <ProjectCard project={project} />)}</ol>
  </section>
  <section class="about-teaser wrap section" aria-labelledby="about-teaser-heading">
    <p class="eyebrow">02 / The person behind the work</p>
    <div><h2 id="about-teaser-heading">More than<br />a collection of projects<span class="accent">.</span></h2><p>From student representation in Antananarivo to design and debate in Singapore, my experiences bring together technology, communication, and community. Away from that work, I enjoy music, swimming, and biking.</p><a class="text-link" href="/about">Read my story <span aria-hidden="true">↗</span></a></div>
  </section>
  <NewsletterSignup />
</BaseLayout>
